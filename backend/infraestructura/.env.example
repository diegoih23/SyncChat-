# Copiar a .env en esta carpeta y usar --env-file en los comandos documentados.
JUAN_IP=192.168.1.10
WAGNER_IP=192.168.1.11
JOSIBEL_IP=192.168.1.12
EMILIO_IP=192.168.1.13
JWT_SECRET=REEMPLAZAR_POR_SECRETO_ALEATORIO_COMPARTIDO
AUTH_DIRECTORY_TOKEN=REEMPLAZAR_POR_TOKEN_INTERNO_ALEATORIO_COMPARTIDO
POSTGRES_USER=syncchat
POSTGRES_PASSWORD=REEMPLAZAR_POR_PASSWORD_ALEATORIO
