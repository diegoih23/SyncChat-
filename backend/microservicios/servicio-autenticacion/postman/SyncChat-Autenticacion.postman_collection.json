{
  "info": {
    "name": "SyncChat - Autenticación",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080/api/auth" },
    { "key": "correo", "value": "ana@example.com" },
    { "key": "id", "value": "REEMPLAZAR_CON_ID_DEL_REGISTRO" },
    { "key": "tokenRecuperacion", "value": "REEMPLAZAR_CON_TOKEN_DE_RECUPERAR" }
  ],
  "item": [
    {
      "name": "Registro",
      "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"nombre\": \"Ana\",\n  \"correo\": \"{{correo}}\",\n  \"password\": \"secreto123\"\n}" }, "url": "{{baseUrl}}/registro" }
    },
    {
      "name": "Login",
      "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"correo\": \"{{correo}}\",\n  \"password\": \"secreto123\"\n}" }, "url": "{{baseUrl}}/login" }
    },
    {
      "name": "Perfil",
      "request": { "method": "GET", "url": "{{baseUrl}}/perfil/{{id}}" }
    },
    {
      "name": "Solicitar recuperación",
      "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"correo\": \"{{correo}}\"\n}" }, "url": "{{baseUrl}}/recuperar" }
    },
    {
      "name": "Restablecer contraseña",
      "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"correo\": \"{{correo}}\",\n  \"token\": \"{{tokenRecuperacion}}\",\n  \"password\": \"nueva-clave123\"\n}" }, "url": "{{baseUrl}}/restablecer" }
    }
  ]
}
